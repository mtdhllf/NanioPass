<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".NanioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NanioPass">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自动填充服务 -->
        <service
            android:name=".autofill.NanioAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- 自动填充前的生物识别认证页（透明，不进入任务栈） -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.NanioPass.Transparent" />

        <!-- 自动填充「使用其他密码…」选择页（FillResponse 级认证返回 Dataset） -->
        <activity
            android:name=".autofill.AutofillPickerActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.NanioPass" />

        <!-- Android 14+ Credential Provider（系统凭据管理器来源） -->
        <service
            android:name=".credential.NanioCredentialProviderService"
            android:exported="true"
            android:label="@string/credential_provider_label"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <activity
            android:name=".credential.CredentialAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.NanioPass.Transparent" />

        <!-- 凭据服务「创建凭据」页（注册/改密时保存到本应用） -->
        <activity
            android:name=".credential.CredentialCreateActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.NanioPass" />

        <!-- 竖屏 + 正方形取景框的扫码页 -->
        <activity
            android:name=".ui.scan.NanioCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.NanioPass.Capture" />
    </application>
</manifest>
